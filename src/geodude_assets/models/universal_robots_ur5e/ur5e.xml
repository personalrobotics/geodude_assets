<mujoco model="ur5e">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="ur5e">
      <!-- Brushed aluminum look: high specular, tight shininess -->
      <material specular="0.9" shininess="0.6"/>
      <!-- Every joint, the elbow included, ranges +/-360 deg. Universal Robots limits the
           real elbow to +/-180 deg (Universal_Robots_ROS2_Description, config/ur5e/
           joint_limits.yaml) to avoid self-collision; this model leaves that to a
           self-collision constraint instead of the joint range. Actuator control ranges
           match the joint ranges, so a commanded position is never clipped short of
           what the arm can reach. -->
      <joint axis="0 1 0" range="-6.283185 6.283185" armature="0.1"/>
      <!-- PD gains: tuned 2026-04-10 via geodude/src/geodude/demos/tune_ur5e_gains.py
           against gravity-compensated dynamics. Target ζ ≈ 0.7 (slightly
           under-critical, responsive). kv derived as class-averaged
           2·ζ·sqrt(kp·J_eff) where J_eff is the max mass-matrix diagonal
           across 4 representative poses. See personalrobotics/geodude_assets#12
           for the sweep methodology and before/after metrics. The gains predate the
           inertials below and the force limits, which are the UR5e's own (150 N m on
           the three large joints, 28 N m on the wrists; Universal_Robots_ROS2_Description
           config/ur5e/joint_limits.yaml). -->
      <general gaintype="fixed" biastype="affine" ctrlrange="-6.283185 6.283185" gainprm="3000" biasprm="0 -3000 -101"
        forcerange="-150 150"/>
      <default class="size1">
        <general gainprm="500" biasprm="0 -500 -11" forcerange="-28 28"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="capsule" group="3"/>
        <default class="eef_collision">
          <geom type="cylinder"/>
        </default>
      </default>
      <site size="0.01" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material class="ur5e" name="black" rgba="0.033 0.033 0.033 1"/>
    <material class="ur5e" name="jointgray" rgba="0.278 0.278 0.278 1"/>
    <material class="ur5e" name="linkgray" rgba="0.65 0.65 0.65 1"/>
    <material class="ur5e" name="urblue" rgba="0.49 0.678 0.8 1"/>

    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="shoulder_0.obj"/>
    <mesh file="shoulder_1.obj"/>
    <mesh file="shoulder_2.obj"/>
    <mesh file="upperarm_0.obj"/>
    <mesh file="upperarm_1.obj"/>
    <mesh file="upperarm_2.obj"/>
    <mesh file="upperarm_3.obj"/>
    <mesh file="forearm_0.obj"/>
    <mesh file="forearm_1.obj"/>
    <mesh file="forearm_2.obj"/>
    <mesh file="forearm_3.obj"/>
    <mesh file="wrist1_0.obj"/>
    <mesh file="wrist1_1.obj"/>
    <mesh file="wrist1_2.obj"/>
    <mesh file="wrist2_0.obj"/>
    <mesh file="wrist2_1.obj"/>
    <mesh file="wrist2_2.obj"/>
    <mesh file="wrist3.obj"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="wrist_2_link" pos="0 -1 2"/>
    <!-- gravcomp="1" on every link: real UR5e controllers (RTDE/URScript)
         run gravity compensation internally; this matches that behavior so
         the PD loop doesn't have to fight gravity via steady-state error.
         MuJoCo optimizes gravcomp away at compile time if every body has
         gravcomp=0, so setting it at runtime is a no-op — it must live in
         the source XML. See personalrobotics/mj_manipulator#84. -->
    <body name="base" quat="0 0 0 -1" childclass="ur5e" gravcomp="1">
      <inertial mass="4.0" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom mesh="base_0" material="black" class="visual"/>
      <geom mesh="base_1" material="jointgray" class="visual"/>
      <body name="shoulder_link" pos="0 0 0.163" gravcomp="1">
        <!-- Link masses, centres of mass and full inertia tensors are the UR5e's own
             (Universal_Robots_ROS2_Description config/ur5e/physical_parameters.yaml), expressed
             in these body frames. Menagerie carries the UR5 values, with idealised cylinder
             inertias centred on each link axis. The base is the same in both. -->
        <inertial mass="3.761" pos="0 0.00193 -0.02611" fullinertia="0.0070021 0.00657286 0.00648091 1.053e-05 -7.3e-07 0.00049994"/>
        <joint name="shoulder_pan_joint" axis="0 0 1"/>
        <geom mesh="shoulder_0" material="urblue" class="visual"/>
        <geom mesh="shoulder_1" material="black" class="visual"/>
        <geom mesh="shoulder_2" material="jointgray" class="visual"/>
        <geom class="collision" size="0.06 0.06" pos="0 0 -0.04"/>
        <body name="upper_arm_link" pos="0 0.138 0" quat="1 0 1 0" gravcomp="1">
          <inertial mass="8.058" pos="0.0005 -0.02464 0.2125" fullinertia="0.33388086 0.33247207 0.01505885 1.81e-06 -5.4e-05 -5.63e-06"/>
          <joint name="shoulder_lift_joint"/>
          <geom mesh="upperarm_0" material="linkgray" class="visual"/>
          <geom mesh="upperarm_1" material="black" class="visual"/>
          <geom mesh="upperarm_2" material="jointgray" class="visual"/>
          <geom mesh="upperarm_3" material="urblue" class="visual"/>
          <geom class="collision" pos="0 -0.04 0" quat="1 1 0 0" size="0.06 0.06"/>
          <geom class="collision" size="0.05 0.2" pos="0 0 0.2"/>
          <body name="forearm_link" pos="0 -0.131 0.425" gravcomp="1">
            <inertial mass="2.846" pos="0.0005 0.0195 0.2422" fullinertia="0.07879254 0.0784851 0.00399632 6.6e-06 -1.365e-05 -0.00137272"/>
            <joint name="elbow_joint"/>
            <geom mesh="forearm_0" material="urblue" class="visual"/>
            <geom mesh="forearm_1" material="linkgray" class="visual"/>
            <geom mesh="forearm_2" material="black" class="visual"/>
            <geom mesh="forearm_3" material="jointgray" class="visual"/>
            <geom class="collision" pos="0 0.08 0" quat="1 1 0 0" size="0.055 0.06"/>
            <geom class="collision" size="0.038 0.19" pos="0 0 0.2"/>
            <body name="wrist_1_link" pos="0 0 0.392" quat="1 0 1 0" gravcomp="1">
              <inertial mass="1.37" pos="-0.0002 0.1245 0.01684" fullinertia="0.00165491 0.00135962 0.00126279 -2.82e-06 -4.38e-06 0.00010157"/>
              <joint name="wrist_1_joint" class="size1"/>
              <geom mesh="wrist1_0" material="black" class="visual"/>
              <geom mesh="wrist1_1" material="urblue" class="visual"/>
              <geom mesh="wrist1_2" material="jointgray" class="visual"/>
              <geom class="collision" pos="0 0.05 0" quat="1 1 0 0" size="0.04 0.07"/>
              <body name="wrist_2_link" pos="0 0.127 0" gravcomp="1">
                <inertial mass="1.3" pos="-0.0002 0.01564 0.0984" fullinertia="0.00135617 0.00096614 0.00127827 4.44e-06 2.74e-06 5.048e-05"/>
                <joint name="wrist_2_joint" axis="0 0 1" class="size1"/>
                <geom mesh="wrist2_0" material="black" class="visual"/>
                <geom mesh="wrist2_1" material="urblue" class="visual"/>
                <geom mesh="wrist2_2" material="jointgray" class="visual"/>
                <geom class="collision" size="0.04 0.06" pos="0 0 0.04"/>
                <geom class="collision" pos="0 0.02 0.1" quat="1 1 0 0" size="0.04 0.04"/>
                <body name="wrist_3_link" pos="0 0 0.1" gravcomp="1">
                  <inertial mass="0.365" pos="-0.0002 0.097741 0.0002" fullinertia="0.00018694 0.00025756 0.00018908 -1.7e-07 -6e-08 9.2e-07"/>
                  <joint name="wrist_3_joint" class="size1"/>
                  <geom material="linkgray" mesh="wrist3" class="visual"/>
                  <geom class="eef_collision" pos="0 0.08 0" quat="1 1 0 0" size="0.04 0.02"/>
                  <!-- F/T sensor at tool flange (tool0 frame): Z+ out, X+ left, Y+ up -->
                  <site name="ft_sensor_site" pos="0 0.1 0" quat="-1 1 0 0"/>
                  <site name="gripper_attachment_site" pos="0 0.1 0" quat="-1 1 0 0"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Adjacent link contact exclusions (kinematic chain) -->
  <contact>
    <exclude body1="base" body2="shoulder_link"/>
    <exclude body1="shoulder_link" body2="upper_arm_link"/>
    <exclude body1="upper_arm_link" body2="forearm_link"/>
    <exclude body1="forearm_link" body2="wrist_1_link"/>
    <exclude body1="wrist_1_link" body2="wrist_2_link"/>
    <exclude body1="wrist_2_link" body2="wrist_3_link"/>
  </contact>

  <actuator>
    <general class="ur5e" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <general class="ur5e" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <general class="ur5e" name="elbow" joint="elbow_joint"/>
    <general class="size1" name="wrist_1" joint="wrist_1_joint"/>
    <general class="size1" name="wrist_2" joint="wrist_2_joint"/>
    <general class="size1" name="wrist_3" joint="wrist_3_joint"/>
  </actuator>

  <!-- Force/Torque sensor at tool flange (matches UR5e built-in F/T sensor) -->
  <!-- Measurements are in the tool0 frame: Z+ out of flange, X+ left, Y+ up -->
  <!-- UR5e F/T sensor specs: Force ±50N range, ±3.5N precision; Torque ±10Nm range, ±0.2Nm precision -->
  <!-- Note: MuJoCo noise is Gaussian std dev. Clamping to range must be done in user code. -->
  <sensor>
    <force name="ft_sensor_force" site="ft_sensor_site" noise="3.5"/>
    <torque name="ft_sensor_torque" site="ft_sensor_site" noise="0.2"/>
  </sensor>

  <keyframe>
    <key name="ready" qpos="-1.5708 -1.5708 1.5708 -1.5708 1.5708 0" ctrl="-1.5708 -1.5708 1.5708 -1.5708 1.5708 0"/>
  </keyframe>
</mujoco>
